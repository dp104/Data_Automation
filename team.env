# Team settings for the hosted University Course Scraper. Fill in, then run ./team-install.sh
UNISCRAPE_TEAM=1
UNISCRAPE_ALLOWED_DOMAIN=flyurdream.com
# cloudflare  (Cloudflare Tunnel + Access)   or   tailscale  (tailscale serve)
UNISCRAPE_AUTH=tailscale
# Required for UNISCRAPE_AUTH=tailscale: the tool trusts the "Tailscale-User-Login" header with no signature
# of its own, which is only safe because `tailscale serve` (set up below) is the sole way anything reaches
# this port and always strips any client-supplied copy of that header. Setting this to 1 is your
# acknowledgement of that - do not set it if this port might ever be reachable another way.
UNISCRAPE_TRUST_TAILSCALE_HEADER=1
# Cloudflare Access: team name (xxx in xxx.cloudflareaccess.com) and the application's AUD tag
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
